{
  "cases": [
    {"name": "strip zeros from the front", "value": "000123",
     "rules": {"strip": "0", "strip_where": "front"}, "expected": "123", "blank": false},
    {"name": "number pads with leading zeros", "value": "123",
     "rules": {"display": "number", "expected_length": 6}, "expected": "000123", "blank": false},
    {"name": "strip runs before number padding", "value": "000123",
     "rules": {"strip": "0", "strip_where": "front", "display": "number", "expected_length": 6},
     "expected": "000123", "blank": false},
    {"name": "number pads the integer part only", "value": "3.5",
     "rules": {"display": "number", "expected_length": 2}, "expected": "03.5", "blank": false},
    {"name": "number leaves a full-length piece alone", "value": "07C",
     "rules": {"display": "number", "expected_length": 3}, "expected": "07C", "blank": false},
    {"name": "trim rear keeps the first characters", "value": "lvn-hm1w2-vc1-c1n7",
     "rules": {"max_chars": 10, "trim": "rear"}, "expected": "lvn-hm1w2-", "blank": false},
    {"name": "trim front keeps the last characters", "value": "lvn-hm1w2-vc1-c1n7",
     "rules": {"max_chars": 10, "trim": "front"}, "expected": "2-vc1-c1n7", "blank": false},
    {"name": "strip anywhere removes every occurrence", "value": "10482",
     "rules": {"strip": "4", "strip_where": "anywhere"}, "expected": "1082", "blank": false},
    {"name": "an empty value is blank", "value": "",
     "rules": {}, "expected": "", "blank": true},
    {"name": "a value stripped to nothing is blank", "value": "0",
     "rules": {"strip": "0", "strip_where": "front"}, "expected": "", "blank": true},
    {"name": "number padding never truncates", "value": "12",
     "rules": {"display": "number", "expected_length": 1}, "expected": "12", "blank": false},

    {"name": "strip rear removes repeats from the end", "value": "1200",
     "rules": {"strip": "0", "strip_where": "rear"}, "expected": "12", "blank": false},
    {"name": "strip front removes a multi-character value while it leads", "value": "ABABC",
     "rules": {"strip": "AB", "strip_where": "front"}, "expected": "C", "blank": false},
    {"name": "strip anywhere is one left-to-right pass", "value": "aabb",
     "rules": {"strip": "ab", "strip_where": "anywhere"}, "expected": "ab", "blank": false},
    {"name": "strip with an empty value does nothing", "value": "000123",
     "rules": {"strip": "", "strip_where": "front"}, "expected": "000123", "blank": false},
    {"name": "strip without a side strips the front", "value": "00120",
     "rules": {"strip": "0"}, "expected": "120", "blank": false},
    {"name": "max characters without a side trims the rear", "value": "ABCDEF",
     "rules": {"max_chars": 3}, "expected": "ABC", "blank": false},
    {"name": "max characters longer than the value does nothing", "value": "AB",
     "rules": {"max_chars": 10, "trim": "front"}, "expected": "AB", "blank": false},
    {"name": "max characters of zero means no limit", "value": "ABC",
     "rules": {"max_chars": 0, "trim": "rear"}, "expected": "ABC", "blank": false},
    {"name": "strip, then trim, then pad", "value": "0001234567",
     "rules": {"strip": "0", "strip_where": "front", "max_chars": 4, "trim": "front",
               "display": "number", "expected_length": 6},
     "expected": "004567", "blank": false},
    {"name": "blank is decided before padding", "value": "000",
     "rules": {"strip": "0", "strip_where": "front", "display": "number", "expected_length": 2},
     "expected": "00", "blank": true},
    {"name": "number pads before the first dot only", "value": "3.5.1",
     "rules": {"display": "number", "expected_length": 3}, "expected": "003.5.1", "blank": false},
    {"name": "number without an expected length does nothing", "value": "7",
     "rules": {"display": "number"}, "expected": "7", "blank": false},
    {"name": "text never pads", "value": "7",
     "rules": {"display": "text", "expected_length": 3}, "expected": "7", "blank": false},
    {"name": "barcode never pads", "value": "42",
     "rules": {"display": "barcode", "expected_length": 4}, "expected": "42", "blank": false},
    {"name": "trim rear counts characters, not UTF-16 units", "value": "😀abc",
     "rules": {"max_chars": 2, "trim": "rear"}, "expected": "😀a", "blank": false},
    {"name": "trim front counts characters, not UTF-16 units", "value": "abc😀",
     "rules": {"max_chars": 2, "trim": "front"}, "expected": "c😀", "blank": false},
    {"name": "padding counts characters, not UTF-16 units", "value": "😀",
     "rules": {"display": "number", "expected_length": 3}, "expected": "00😀", "blank": false}
  ]
}
