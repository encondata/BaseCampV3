{
  "type": "doc",
  "content": [
    {
      "type": "paragraph",
      "content": [
        {
          "text": "The Zebra DS22 scanners act like a keyboard: whatever they scan is typed into the field that has the cursor, then Enter is pressed. That works in the kiosk apps (web, laptop, Android and iOS) and in any other app.",
          "type": "text"
        }
      ]
    },
    {
      "type": "table",
      "content": [
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableHeader",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Model",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableHeader",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "How it connects",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableHeader",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Charging",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "DS2208",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": " (corded)",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "USB cable to the computer or tablet",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "None needed",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "DS2278",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": " (cordless)",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Bluetooth straight to a phone, tablet or laptop, or through its CR2278 cradle plugged into a computer by USB",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "In the cradle, or with the micro USB cable (charge only)",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Scanning",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "start": 1
      },
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Tap or click the scan field on the screen so it has the cursor.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Point the scanner at the barcode and pull the trigger.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "A beep and a green flash mean the scan worked. The value appears in the field and is submitted.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "A DS2278 sitting in its cradle can also scan hands-free: hold the barcode in front of it.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Setting up a scanner",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "The barcodes for every step are in the ",
          "type": "text"
        },
        {
          "text": "Appendix",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "text": " at the end of this page (A1 to A4). Scan them from the screen or from a printout.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "DS2208 (corded)",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "start": 1
      },
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Plug the scanner into the device's USB port. It works as a USB keyboard out of the box.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Scan ",
                  "type": "text"
                },
                {
                  "text": "A4 Add Enter key",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": ", then scan any barcode into a scan field to test it.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "DS2278 (cordless), paired straight to a phone, tablet or laptop",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "start": 1
      },
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Charge the scanner fully before first use. If it was used somewhere else, scan ",
                  "type": "text"
                },
                {
                  "text": "A1 Factory reset",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Scan ",
                  "type": "text"
                },
                {
                  "text": "A2 HID mode (DS2278)",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": ". The scanner is now ready to pair.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "On the device, open ",
                  "type": "text"
                },
                {
                  "text": "Settings › Bluetooth",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " and pick the scanner from the list. A low-high beep and a green light mean it's connected.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Scan ",
                  "type": "text"
                },
                {
                  "text": "A4 Add Enter key",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": ", then scan any barcode into a scan field to test it.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "DS2278 with its cradle",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Plug the cradle into the computer's USB port, then set the scanner in the cradle or scan the pairing barcode on the back of the cradle. This is the scanner's factory setting, so no HID barcode is needed. Scan ",
          "type": "text"
        },
        {
          "text": "A4 Add Enter key",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        },
        {
          "text": " once it's connected.",
          "type": "text"
        }
      ]
    },
    {
      "type": "callout",
      "attrs": {
        "variant": "warning"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "A1 Factory reset clears every setting,",
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "text": " including the Enter key, and puts a DS2278 back in cradle mode. Repeat the setup steps after a reset. To pair with a cradle right after a reset, wait five seconds before scanning the cradle's barcode.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Beeps and lights",
          "type": "text"
        }
      ]
    },
    {
      "type": "table",
      "content": [
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableHeader",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "You hear / see",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableHeader",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "It means",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "One beep, green flash",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "The barcode was scanned.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Low-high beep, green",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "DS2278: Bluetooth connected.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "High-low beep, red",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "DS2278: Bluetooth disconnected.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Long low, long high beep, red",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "DS2278: the device it's paired to is out of range or turned off.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Four short high beeps, red for 4 seconds",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "DS2278: low battery. Charge it.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Troubleshooting",
          "type": "text"
        }
      ]
    },
    {
      "type": "table",
      "content": [
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableHeader",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Problem",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableHeader",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "What to do",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Nothing appears when you scan",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Tap the scan field so it has the cursor. For a DS2278, check it's connected (it beeps low-high when it connects).",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "The value appears but isn't submitted",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Scan ",
                      "type": "text"
                    },
                    {
                      "text": "A4 Add Enter key",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "The phone or tablet doesn't list the DS2278",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Scan ",
                      "type": "text"
                    },
                    {
                      "text": "A2 HID mode (DS2278)",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": ". If it's still connected to another device, scan ",
                      "type": "text"
                    },
                    {
                      "text": "A3",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": " first.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Moving a DS2278 to another device",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Scan ",
                      "type": "text"
                    },
                    {
                      "text": "A3 Pairing mode (DS2278)",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": ", then pick the scanner in the new device's ",
                      "type": "text"
                    },
                    {
                      "text": "Settings › Bluetooth",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": ".",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "The scanner behaves oddly after its settings were changed",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Scan ",
                      "type": "text"
                    },
                    {
                      "text": "A1 Factory reset",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": ", then set it up again.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Appendix: programming barcodes",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Each barcode changes a setting on the scanner, which keeps it until it's changed again or reset. They come from Zebra's DS2208 and DS2278 Product Reference Guides.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "A1 Factory reset (both models)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Clears every setting and puts the scanner back to Zebra's factory defaults.",
          "type": "text"
        }
      ]
    },
    {
      "type": "wikiImage",
      "attrs": {
        "alt": "Set Factory Defaults",
        "width": 190,
        "assetId": "factory-defaults.png",
        "caption": "Set Factory Defaults"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "A2 HID mode",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Makes the scanner type its scans like a keyboard. Scan the one for your model.",
          "type": "text"
        }
      ]
    },
    {
      "type": "wikiImage",
      "attrs": {
        "alt": "DS2208: USB Keyboard HID",
        "width": 350,
        "assetId": "ds2208-usb-keyboard-hid.png",
        "caption": "DS2208: USB Keyboard HID"
      }
    },
    {
      "type": "wikiImage",
      "attrs": {
        "alt": "DS2278: HID Bluetooth Classic (also makes it ready to pair)",
        "width": 360,
        "assetId": "ds2278-hid-bluetooth-classic.png",
        "caption": "DS2278: HID Bluetooth Classic (also makes it ready to pair)"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "A3 Pairing mode (DS2278 only)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Disconnects the scanner from its current device or cradle so a new device can pair with it. The scanner must be in HID mode (A2) to pair straight to a phone, tablet or laptop.",
          "type": "text"
        }
      ]
    },
    {
      "type": "wikiImage",
      "attrs": {
        "alt": "DS2278: Unpairing",
        "width": 410,
        "assetId": "ds2278-unpairing.png",
        "caption": "DS2278: Unpairing"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "A4 Add Enter key (both models)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Adds a carriage return (Enter) after every scan, so each scan is submitted on its own.",
          "type": "text"
        }
      ]
    },
    {
      "type": "wikiImage",
      "attrs": {
        "alt": "Add Enter Key (Carriage Return/Line Feed)",
        "width": 470,
        "assetId": "add-enter-key.png",
        "caption": "Add Enter Key (Carriage Return/Line Feed)"
      }
    }
  ]
}
