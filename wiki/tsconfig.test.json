// Typechecks the wiki server's tests (tsconfig.server.json compiles the
// server and leaves them out; web tests are covered by tsconfig.json).
// Tests import without `.js` like the web side, so resolve as a bundler.
{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["server/src/**/*.ts", "web/src/editor/**/*.ts"],
  "exclude": []
}
