# ============================================================
# ServerSherpa wiki — environment configuration template
# ============================================================
# Copy to `.env` (git-ignored) and fill in real values:
#   cp wiki/.env.example wiki/.env
# install.sh does this for you on its first run.
#
# This file feeds BOTH containers in wiki/docker-compose.yml:
#   - `wiki`        (wiki/Dockerfile)        reads only the WIKI_* lines
#   - `wiki-worker` (wiki/Dockerfile.worker) reads the SS_* lines — it
#     talks to Postgres and Spaces directly, so it needs the same
#     settings the main API reads from the repo-root .env. Copy those
#     values from there (see /opt/serversherpa/.env or wherever the main
#     stack's .env lives) rather than inventing new ones: the database
#     and bucket must be the same ones the API uses.
# ============================================================

# ── wiki (the web/collab image) ─────────────────────────────
# Host port the container publishes on (container always listens on 8080).
WIKI_PORT=8096
# The main API's origin AS THE CONTAINER SEES IT — not the browser. In
# development with the API running on the host: http://host.docker.internal:8000
WIKI_API_URL=http://host.docker.internal:8000
# Shared secret for /wiki/internal/* — must equal SS_WIKI_SERVICE_TOKEN
# in the main API's .env. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WIKI_SERVICE_TOKEN=CHANGEME

# ── wiki-worker (LibreOffice/poppler/WeasyPrint image) ──────
# The full API settings below are required because the API's pydantic
# Settings model validates all of them together, even though the worker
# only uses the database and object-storage ones day to day. Values that
# say "unused by the worker" still need to be present and well-formed.
SS_ENV=production                 # production | staging | development
SS_LOG_LEVEL=INFO
SS_API_BASE_URL=https://api.example.com   # unused by the worker; must still be a URL

# Database — same Postgres the main API uses.
SS_DATABASE_URL=postgresql+asyncpg://serversherpa_app:CHANGEME@private-db-host:25060/serversherpa
SS_DATABASE_SSL=require           # require (prod/staging) | disable (dev only)

# Auth/crypto — unused by the worker, but required by the shared Settings
# model. Copy the same values as the main API's .env.
SS_JWT_SECRET=CHANGEME
SS_TOTP_ENCRYPTION_KEY=CHANGEME
SS_PASSWORD_PEPPER=CHANGEME

# Object storage (DO Spaces in prod, MinIO in dev) — where file previews,
# extracted text targets, and export output live.
SS_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com   # dev: http://localhost:9000
SS_SPACES_REGION=nyc3                   # dev: us-east-1 (MinIO default)
SS_SPACES_BUCKET=serversherpa-prod          # dev: serversherpa-dev
SS_SPACES_ACCESS_KEY=CHANGEME
SS_SPACES_SECRET_KEY=CHANGEME
SS_SPACES_USE_PATH_STYLE=false          # dev: true (MinIO needs path-style URLs)

# Wiki settings the worker shares with the API — keep them EQUAL to the
# main API's .env (the API shows purge dates from its value; the worker's
# expiry sweep deletes on this one).
SS_WIKI_TRASH_DAYS=30
SS_WIKI_MAX_UPLOAD_BYTES=1073741824

# Export limits (worker only): an export with more pages, or whose files
# and page images add up to more bytes, fails with a message saying so.
SS_WIKI_EXPORT_MAX_PAGES=1000
SS_WIKI_EXPORT_MAX_BYTES=2147483648
