# Devices service settings (copy to devices/.env, which is git-ignored).
# Every key is DEVICES_*. See devices/README.md for the dev bring-up.
DEVICES_ENV=development
# Dev Postgres (docker-compose.dev.yml): the repo .env's POSTGRES_USER / POSTGRES_PASSWORD.
DEVICES_DATABASE_URL=postgresql+asyncpg://serversherpa:CHANGEME-dev-only@127.0.0.1:5433/serversherpa_devices
DEVICES_MAIN_API_URL=http://localhost:8000
# Same value as the main API's SS_DEVICES_SERVICE_TOKEN.
DEVICES_SERVICE_TOKEN=CHANGEME
# Fernet key: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DEVICES_SECRET_KEY=CHANGEME
DEVICES_PUBLIC_URL=https://devices.dev.serversherpa.com
# Dev MinIO, mirroring the main API's SS_SPACES_* values.
DEVICES_SPACES_ENDPOINT=https://files.dev.serversherpa.com
DEVICES_SPACES_REGION=us-east-1
DEVICES_SPACES_BUCKET=serversherpa-devices
DEVICES_SPACES_ACCESS_KEY=CHANGEME
DEVICES_SPACES_SECRET_KEY=CHANGEME
DEVICES_SPACES_USE_PATH_STYLE=true
