#!/usr/bin/env bash
# ss-stack — run one ServerSherpa environment's Compose stacks (db, storage,
# api, web, status, and proxy on a DigitalOcean droplet) on this host, in
# dependency order.
#
#   ss-stack build   <env-dir>              build every image at STACK_IMAGE_TAG
#   ss-stack up      <env-dir>              start or update everything, waiting on health
#   ss-stack down    <env-dir> [--volumes]  stop everything; --volumes also deletes the data
#   ss-stack ps      <env-dir>              list every stack's containers
#   ss-stack dump    <env-dir>              pg_dump into <env-dir>/backups (keeps STACK_KEEP_DUMPS)
#   ss-stack data    <env-dir>              start only the database and storage, waiting on health
#   ss-stack restore <env-dir> <file.dump> [--clear-sessions]
#                                           stop the app stacks, empty the database, pg_restore the
#                                           dump; --clear-sessions also signs everyone out
#   ss-stack pgdump  <env-dir> <out.dump>   pg_dump (custom, no owner or ACLs) to one file
#   ss-stack revision <env-dir>             print the database's Alembic revision
#   ss-stack admin   <env-dir> <args…>      serversherpa bootstrap-admin in the running api
#                                           container; stdin (a password) passes through
#   ss-stack seed    <env-dir> [--learning] starter content in the running api container: label
#                                           fonts and templates, and the Learning space when learn runs
#   ss-stack has-data <env-dir>             exit 0: this host's database has ServerSherpa's tables;
#                                           3: no data yet; 4: the database is shared or elsewhere
#   ss-stack accepts <env-dir> <file>       exit 0 when this commit can run a database at the
#                                           revision in <file> (up migrates it); 3 when it can't
#   ss-stack verify-dump <env-dir> <file>   check that <file> is a complete pg_dump archive
#   ss-stack clear-sessions <env-dir>       sign everyone out (a copy's sessions belong to its source)
#   ss-stack export-objects <env-dir> <out.tar>
#                                           every object of the bucket into one tar (deploy/stack/objects.py)
#   ss-stack import-objects <env-dir> <in.tar>
#                                           put a tar's objects into the bucket (same keys replaced)
#
# <env-dir> holds the environment's .env (see env.example) and backups/.
# With STACK_EXTERNAL_DATA=1 (DigitalOcean) the database is a managed
# PostgreSQL and objects live in DigitalOcean Spaces: the db and storage
# stacks don't run (mailpit does), and the database commands use one-off
# postgres containers. With STACK_CADDY=1 the proxy stack (Caddy) runs last.
# With STACK_DB_PUBLISH=1 (a LAN Blue/Green data VM) the db stack listens on
# the LAN for STACK_DB_ALLOW's addresses only (pg_hba.conf, written here).
# STACK_DB_SSLMODE=disable: the external database is a LAN data VM (no TLS).
# STACK_APPS lists the optional apps that run (wiki, kiosk, learn, status, mailpit;
# "none" for none); without it every app runs. API and portal always run. The
# learning site needs the wiki (its documents render there).
# Sirdar's deploy pipeline runs exactly these commands over SSH.
set -euo pipefail
# dumps hold every secret in the database: backups/ and its files are owner-only
umask 077

STACK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WAIT=(--wait --wait-timeout 300 --remove-orphans)
PG_IMAGE=postgres:16-alpine
CA_MOUNT=/run/ss-db-ca.pem

# Files to remove however ss-stack exits (a signal trap turns a signal into
# an exit, so this runs then too).
CLEANUP=()
cleanup() { if (( ${#CLEANUP[@]} )); then rm -f -- "${CLEANUP[@]}"; fi; }
trap cleanup EXIT

die() { echo "ss-stack: $*" >&2; exit 1; }
# The usage text is the header's command list: from line 6 to the first bare "#".
usage() { sed -n '6,/^#$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2; }

[[ $# -ge 2 ]] || usage
cmd=$1
env_dir=$(cd "$2" 2>/dev/null && pwd) || die "no such environment directory: $2"
shift 2
env_file="$env_dir/.env"
[[ -f $env_file ]] || die "missing $env_file (copy deploy/stack/env.example)"

# One value from the env file: last assignment wins, surrounding quotes dropped.
env_value() {
  local v
  v=$(sed -n "s/^$1=//p" "$env_file" | tail -n 1)
  v=${v%\"}; v=${v#\"}; v=${v%\'}; v=${v#\'}
  printf '%s' "$v"
}

STACK_ENV=$(env_value STACK_ENV)
[[ $STACK_ENV =~ ^[a-z][a-z0-9-]{0,30}[a-z0-9]$ ]] \
  || die "STACK_ENV must be 2-32 lowercase letters, digits and hyphens (got '$STACK_ENV')"
NETWORK="ss-$STACK_ENV"
SUBNET=$(env_value STACK_NETWORK_SUBNET)
external() { [[ $(env_value STACK_EXTERNAL_DATA) == 1 ]]; }
caddy() { [[ $(env_value STACK_CADDY) == 1 ]]; }
lan_db() { [[ $(env_value STACK_DB_PUBLISH) == 1 ]]; }

# STACK_APPS is exact: comma-separated names from the list (lowercase, no
# spaces, no empty entries), or "none" alone. Anything else is refused
# rather than guessed at.
check_apps() {
  local apps app list
  apps=$(env_value STACK_APPS)
  [[ -z $apps || $apps == none ]] && return 0
  [[ $apps =~ ^[^,]+(,[^,]+)*$ ]] \
    || die "STACK_APPS must list wiki, kiosk, learn, status or mailpit, comma-separated with no spaces (or none)"
  IFS=, read -ra list <<<"$apps"
  for app in "${list[@]}"; do
    case $app in
      wiki|kiosk|learn|status|mailpit) ;;
      none) die "STACK_APPS: none can't be combined with other apps" ;;
      *) die "STACK_APPS has '$app', not one of wiki, kiosk, learn, status, mailpit (lowercase, no spaces)" ;;
    esac
  done
  if app_on learn && ! app_on wiki; then
    die "The learning site needs the wiki: turn the wiki on, or turn learning off."
  fi
}

# Mail goes to Mailpit unless the .env names an SMTP server.
check_mail() {
  if ! app_on mailpit && [[ -z $(env_value SS_SMTP_HOST) ]]; then
    die "Mailpit is off and no SMTP host is set: mail would fail."
  fi
}

# An optional app runs unless STACK_APPS is set and doesn't name it.
app_on() {
  local apps
  apps=$(env_value STACK_APPS)
  [[ -z $apps ]] && return 0
  [[ ",$apps," == *",$1,"* ]]
}
HBA_FILE="$env_dir/pg_hba.conf"

# pg_hba.conf for a data VM: the local socket (ss-stack dump, the health
# check), localhost, and the app servers in STACK_DB_ALLOW; nobody else.
# Every address (and STACK_DB_PORT) is checked before the file changes. The
# container bind-mounts the file itself, which pins its inode: a changed
# list is written into the same file (never mv'd over it), then a running
# Postgres rereads it.
write_hba() {
  local allow ip ips octet octets port
  port=$(env_value STACK_DB_PORT)
  if [[ -n $port ]]; then
    if ! { [[ $port =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )); }; then
      die "STACK_DB_PORT must be a port number, 1-65535 (got '$port')"
    fi
  fi
  allow=$(env_value STACK_DB_ALLOW)
  [[ $allow =~ ^[^,]+(,[^,]+)*$ ]] \
    || die "STACK_DB_ALLOW must list the app servers' IPv4 addresses, comma-separated"
  IFS=, read -ra ips <<<"$allow"
  for ip in "${ips[@]}"; do
    [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] \
      || die "STACK_DB_ALLOW has '$ip', not an IPv4 address"
    IFS=. read -ra octets <<<"$ip"
    for octet in "${octets[@]}"; do
      # no leading zeros: some readers take 010 as octal
      if ! { [[ $octet =~ ^(0|[1-9][0-9]{0,2})$ ]] && (( octet <= 255 )); }; then
        die "STACK_DB_ALLOW has '$ip', not an IPv4 address"
      fi
    done
  done
  CLEANUP+=("$HBA_FILE.tmp")
  {
    echo "# Written by ss-stack from STACK_DB_ALLOW: edits are replaced."
    echo "local all all trust"
    echo "host all all 127.0.0.1/32 scram-sha-256"
    for ip in "${ips[@]}"; do
      echo "host serversherpa serversherpa $ip/32 scram-sha-256"
    done
  } > "$HBA_FILE.tmp"
  export STACK_DB_HBA_FILE="$HBA_FILE"
  if [[ ! -f $HBA_FILE ]]; then
    chmod 644 "$HBA_FILE.tmp"        # the container's postgres user reads it
    mv "$HBA_FILE.tmp" "$HBA_FILE"
    return 0
  fi
  if cmp -s "$HBA_FILE.tmp" "$HBA_FILE"; then return 0; fi
  cat "$HBA_FILE.tmp" > "$HBA_FILE"   # the same inode the container sees
  chmod 644 "$HBA_FILE"
  if [[ -n $(dc db ps --status running -q postgres </dev/null) ]]; then
    dc db exec -T postgres psql -U serversherpa -d serversherpa -v ON_ERROR_STOP=1 \
      -tAc 'SELECT pg_reload_conf()' </dev/null >/dev/null \
      || die "couldn't make Postgres reread pg_hba.conf"
  fi
}

# On a droplet the network is a fixed /24 whose lower half is for fixed
# addresses (Caddy's STACK_PROXY_IP is .2) and whose upper half (.128/25) is
# where Docker hands out automatic ones. Without the ip-range, whichever
# container starts first (mailpit) takes .2 and Caddy can't start.
IP_RANGE=""
if external && [[ -n $SUBNET ]]; then
  [[ $SUBNET =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})\.0/24$ ]] \
    || die "STACK_NETWORK_SUBNET must be a /24 ending in .0/24 (got '$SUBNET')"
  IP_RANGE="${BASH_REMATCH[1]}.128/25"
fi

# A droplet keeps objects in Spaces (SS_SPACES_SECRET_KEY) and never runs
# SeaweedFS, but Compose still interpolates the storage file's
# ${SPACES_SECRET_KEY:?} when it starts mailpit from it: give it a
# placeholder when the .env has none. Local stacks are untouched.
if external && [[ -z $(env_value SPACES_SECRET_KEY) ]]; then
  export SPACES_SECRET_KEY=unused-external-data
fi

if external; then STACKS=(storage api web status); else STACKS=(db storage api web status); fi
if caddy; then STACKS+=(proxy); fi

dc() {  # dc <stack> <compose args…>
  local stack=$1; shift
  local files=(-f "$STACK_DIR/$stack/compose.yml")
  # A data VM's database listens on the LAN (db/lan.yml).
  if [[ $stack == db ]] && lan_db; then files+=(-f "$STACK_DIR/db/lan.yml"); fi
  # On a droplet the api stack also runs the cert-worker (profile certs).
  if [[ $stack == api ]] && caddy; then set -- --profile certs "$@"; fi
  docker compose --env-file "$env_file" "${files[@]}" "$@"
}

ensure_network() {
  if docker network inspect "$NETWORK" >/dev/null 2>&1; then
    if [[ -n $IP_RANGE ]]; then
      local have have_subnet have_range
      have=$(docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}} {{.IPRange}}{{end}}' "$NETWORK")
      read -r have_subnet have_range <<<"$have" || true
      [[ $have_subnet == "$SUBNET" && $have_range == "$IP_RANGE" ]] \
        || die "network $NETWORK has subnet ${have_subnet:-(none)} and ip-range ${have_range:-(none)}, not $SUBNET and $IP_RANGE: remove it (docker network rm $NETWORK, after ss-stack down) and run again"
    elif [[ -n $SUBNET ]]; then
      local have
      have=$(docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$NETWORK")
      [[ $have == "$SUBNET" ]] \
        || die "network $NETWORK has subnet '$have', not $SUBNET: remove it (docker network rm $NETWORK) and run again"
    fi
    return
  fi
  if [[ -n $IP_RANGE ]]; then
    docker network create --subnet "$SUBNET" --ip-range "$IP_RANGE" "$NETWORK" >/dev/null
  elif [[ -n $SUBNET ]]; then
    docker network create --subnet "$SUBNET" "$NETWORK" >/dev/null
  else
    docker network create "$NETWORK" >/dev/null
  fi
}

# The managed database's CA (SS_DATABASE_CA_B64, a base64 PEM) in an
# owner-only temp file, written once per run and removed on exit. Never run
# pg() in a subshell: the file's path must stay in this shell's CLEANUP.
CA_FILE=""
ca_file() {
  [[ -z $CA_FILE ]] || return 0
  local b64
  b64=$(env_value SS_DATABASE_CA_B64)
  [[ -n $b64 ]] || return 0
  CA_FILE=$(mktemp "${TMPDIR:-/tmp}/ss-db-ca.XXXXXX")
  CLEANUP+=("$CA_FILE")
  chmod 600 "$CA_FILE"
  if ! printf '%s' "$b64" | base64 -d > "$CA_FILE" 2>/dev/null || ! pem_ok "$CA_FILE"; then
    die "SS_DATABASE_CA_B64 isn't a base64 PEM certificate"
  fi
}

# A PEM certificate: BEGIN and END lines with a body between them, and (when
# openssl is here, as on Ubuntu) a certificate openssl can read.
pem_ok() {
  awk '/^-----BEGIN CERTIFICATE-----$/ { inside = 1; body = 0; next }
       /^-----END CERTIFICATE-----$/ { if (inside && body) ok = 1; inside = 0; next }
       inside && NF { body = 1 }
       END { exit !ok }' "$1" || return 1
  if command -v openssl >/dev/null 2>&1; then
    openssl x509 -noout -in "$1" >/dev/null 2>&1 || return 1
  fi
}

# The managed database: a one-off client container on the environment's
# network. The password reaches docker through the environment, never argv.
# With the cluster's CA, the client verifies the server's certificate and
# name (verify-full); without it, TLS is required but unverified.
# STACK_DB_SSLMODE=disable (a LAN data VM) turns TLS off, CA or not.
pg() {  # pg <client> [args…] — stdin and stdout pass through
  local client=$1; shift
  local mode tls
  mode=$(env_value STACK_DB_SSLMODE)
  mode=${mode:-require}
  [[ $mode == require || $mode == disable ]] || die "STACK_DB_SSLMODE must be require or disable"
  tls=(-e "PGSSLMODE=$mode")
  if [[ $mode == require ]]; then ca_file; fi
  if [[ $mode == require && -n $CA_FILE ]]; then
    tls=(-v "$CA_FILE:$CA_MOUNT:ro" -e PGSSLMODE=verify-full -e PGSSLROOTCERT="$CA_MOUNT")
  fi
  ensure_network
  PGPASSWORD=$(env_value POSTGRES_PASSWORD) docker run --rm -i --network "$NETWORK" \
    -e PGPASSWORD "${tls[@]}" \
    -e PGHOST="$(env_value STACK_DB_HOST)" -e PGPORT="$(env_value STACK_DB_PORT)" \
    -e PGUSER="$(env_value STACK_DB_USER)" -e PGDATABASE="$(env_value STACK_DB_NAME)" \
    "$PG_IMAGE" "$client" "$@"
}

# The local database container (db stack).
pg_local() {  # pg_local <client> [args…]
  local client=$1; shift
  dc db exec -T postgres "$client" -U serversherpa -d serversherpa "$@"
}

psql_run() {  # psql_run <sql> — on whichever database this environment uses
  if external; then
    pg psql -v ON_ERROR_STOP=1 -q -c "$1" </dev/null
  else
    pg_local psql -v ON_ERROR_STOP=1 -q -c "$1" </dev/null
  fi
}

data_up() {
  if external; then
    if app_on mailpit; then
      dc storage up -d "${WAIT[@]}" mailpit
    else
      dc storage rm -sf mailpit
    fi
  else
    dc db up -d "${WAIT[@]}"
    # a data VM keeps objects only: its app VMs run their own mail catchers
    if lan_db; then
      dc storage up -d "${WAIT[@]}" seaweedfs
    elif app_on mailpit; then
      dc storage up -d "${WAIT[@]}"
    else
      dc storage up -d "${WAIT[@]}" --scale mailpit=0
    fi
  fi
}

# A restored copy's sessions and remembered browsers belong to the source.
CLEAR_SESSIONS="DO \$\$ BEGIN IF to_regclass('public.auth_sessions') IS NOT NULL THEN DELETE FROM auth_sessions; END IF; IF to_regclass('public.trusted_devices') IS NOT NULL THEN DELETE FROM trusted_devices; END IF; END \$\$;"

refuse_placeholders() {
  local left
  left=$(grep -oE '^[A-Z0-9_]+=CHANGEME' "$env_file" | cut -d= -f1 | tr '\n' ' ' || true)
  [[ -z $left ]] || die "replace the CHANGEME values in $env_file: $left"
}

# pg_dump to stdout, custom format; extra args pass through.
dump_db() {
  if external; then
    pg pg_dump -Fc "$@" </dev/null
  else
    pg_local pg_dump -Fc "$@"
  fi
}

# objects.py (export or import) in a one-off container of this release's api
# image, which has boto3, on the environment's network. It reaches the
# bucket the API uses: the bucket at SS_SPACES_ENDPOINT when the .env names
# one (Spaces on a droplet, or a data VM's SeaweedFS), else this host's
# SeaweedFS. Only the file's folder is mounted (read-only for an import),
# and the container runs as this user, so an owner-only folder is still
# readable. Every S3 setting reaches docker through the environment: argv
# holds names only, never the key or the secret.
objects_run() {  # objects_run export|import <file>
  local action=$1 file=$2 dir name endpoint key secret bucket region style tag image ro=""
  dir=$(cd "$(dirname "$file")" 2>/dev/null && pwd) || die "no such folder: $(dirname "$file")"
  name=$(basename "$file")
  endpoint=$(env_value SS_SPACES_ENDPOINT)
  if [[ -n $endpoint ]]; then
    key=$(env_value SS_SPACES_ACCESS_KEY)
    key=${key:-serversherpa}
    secret=$(env_value SS_SPACES_SECRET_KEY)
    [[ -n $secret ]] || secret=$(env_value SPACES_SECRET_KEY)
  elif external; then
    die "STACK_EXTERNAL_DATA=1 keeps the objects in the bucket at SS_SPACES_ENDPOINT, which isn't set"
  else
    # SeaweedFS's fixed key (storage/compose.yml)
    endpoint=http://seaweedfs:8333
    key=serversherpa
    secret=$(env_value SPACES_SECRET_KEY)
  fi
  [[ -n $secret ]] || die "no secret key for the object store (SS_SPACES_SECRET_KEY or SPACES_SECRET_KEY)"
  bucket=$(env_value SS_SPACES_BUCKET)
  region=$(env_value SS_SPACES_REGION)
  style=$(env_value SS_SPACES_USE_PATH_STYLE)
  tag=$(env_value STACK_IMAGE_TAG)
  [[ -n $tag ]] || die "STACK_IMAGE_TAG isn't set, so there is no api image to run"
  image=$(env_value STACK_API_IMAGE)
  image="${image:-serversherpa-api}:$tag"
  if [[ $action == import ]]; then ro=":ro"; fi
  ensure_network
  SS_OBJECTS_ENDPOINT=$endpoint SS_OBJECTS_KEY_ID=$key SS_OBJECTS_SECRET=$secret \
  SS_OBJECTS_BUCKET=${bucket:-serversherpa} SS_OBJECTS_REGION=${region:-us-east-1} \
  SS_OBJECTS_PATH_STYLE=${style:-true} \
    docker run --rm --network "$NETWORK" --user "$(id -u):$(id -g)" -e HOME=/tmp \
      -e SS_OBJECTS_ENDPOINT -e SS_OBJECTS_KEY_ID -e SS_OBJECTS_SECRET -e SS_OBJECTS_BUCKET \
      -e SS_OBJECTS_REGION -e SS_OBJECTS_PATH_STYLE \
      -v "$STACK_DIR/objects.py:/objects.py:ro" -v "$dir:/work$ro" \
      "$image" python /objects.py "$action" "/work/$name" </dev/null
}

# Leading and trailing blanks (a newline after a revision) dropped.
trim() {
  local v=$1
  v=${v#"${v%%[![:space:]]*}"}
  v=${v%"${v##*[![:space:]]}"}
  printf '%s' "$v"
}

case $cmd in
  build)
    [[ $# -eq 0 ]] || usage
    refuse_placeholders
    docker compose --env-file "$env_file" -f "$STACK_DIR/build.yml" build
    ;;
  up)
    [[ $# -eq 0 ]] || usage
    refuse_placeholders
    check_apps
    check_mail
    if lan_db; then write_hba; fi
    ensure_network
    data_up
    dc api run --rm migrate
    # the apps STACK_APPS leaves out scale to zero (the status page stops)
    api_off=()
    app_on wiki || api_off=(--scale wiki-worker=0 --scale wiki-export-worker=0)
    dc api up -d "${WAIT[@]}" ${api_off[@]+"${api_off[@]}"}
    web_off=()
    app_on kiosk || web_off+=(--scale kiosk=0)
    app_on wiki || web_off+=(--scale wiki=0)
    app_on learn || web_off+=(--scale learn=0)
    dc web up -d "${WAIT[@]}" ${web_off[@]+"${web_off[@]}"}
    if app_on status; then
      # The status page leaves out an app that is off (an empty URL); one
      # that runs gets compose's default, never a value from the caller.
      ( unset STATUS_KIOSK_URL STATUS_WIKI_URL STATUS_LEARN_URL
        app_on kiosk || export STATUS_KIOSK_URL=
        app_on wiki || export STATUS_WIKI_URL=
        app_on learn || export STATUS_LEARN_URL=
        dc status up -d "${WAIT[@]}" )
    else
      dc status down
    fi
    if caddy; then dc proxy up -d "${WAIT[@]}"; fi
    ;;
  down)
    volumes=""
    if [[ ${1:-} == --volumes ]]; then volumes="--volumes"; shift; fi
    [[ $# -eq 0 ]] || usage
    # Compose interpolates db/lan.yml's ${STACK_DB_HBA_FILE:?} even to stop it
    if lan_db; then export STACK_DB_HBA_FILE="$HBA_FILE"; fi
    for (( i=${#STACKS[@]}-1; i>=0; i-- )); do
      # $volumes is deliberately unquoted: empty means no argument at all
      # shellcheck disable=SC2086
      dc "${STACKS[i]}" down $volumes
    done
    if [[ -n $volumes ]]; then docker network rm "$NETWORK" >/dev/null 2>&1 || true; fi
    ;;
  data)
    [[ $# -eq 0 ]] || usage
    refuse_placeholders
    check_apps
    if lan_db; then write_hba; fi
    ensure_network
    data_up
    ;;
  restore)
    [[ $# -eq 1 || $# -eq 2 ]] || usage
    dump=$1
    clear=""
    if [[ $# -eq 2 ]]; then
      [[ $2 == --clear-sessions ]] || usage
      clear=1
    fi
    [[ -f $dump && -r $dump ]] || die "no such dump file: $dump"
    refuse_placeholders
    if lan_db; then write_hba; fi
    # a bad CA must stop us while the stack still runs, not after the stop
    if external; then ca_file; fi
    ensure_network
    # nothing may write while the database is replaced: stop the writers
    # (stopping a stack that isn't running is a no-op), keep the database up.
    # This stops writers only on this droplet (this host). On DigitalOcean
    # two slots share one managed database, so Sirdar (phase 7b) restores
    # only while no slot has run a deploy (pipeline: seed_not_allowed; an
    # added slot's first deploy never seeds): no other slot is writing.
    for s in status web api; do dc "$s" stop </dev/null; done
    if ! external; then dc db up -d "${WAIT[@]}" </dev/null; fi
    # an empty schema, never pg_restore --clean: tables a newer migration
    # created aren't in the dump, and --clean would leave them behind
    psql_run 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' \
      || die "couldn't empty the database"
    if external; then
      pg pg_restore --exit-on-error --no-owner --no-acl -d "$(env_value STACK_DB_NAME)" \
        < "$dump" || die "pg_restore failed"
    else
      dc db exec -T postgres pg_restore --exit-on-error --no-owner --no-acl \
        -U serversherpa -d serversherpa < "$dump" || die "pg_restore failed"
    fi
    if [[ -n $clear ]]; then
      psql_run "$CLEAR_SESSIONS" || die "couldn't clear the sessions"
    fi
    echo "restored $dump"
    ;;
  ps)
    [[ $# -eq 0 ]] || usage
    # Compose interpolates db/lan.yml's ${STACK_DB_HBA_FILE:?}
    if lan_db; then export STACK_DB_HBA_FILE="$HBA_FILE"; fi
    for s in "${STACKS[@]}"; do dc "$s" ps; done
    ;;
  dump)
    [[ $# -eq 0 ]] || usage
    keep=$(env_value STACK_KEEP_DUMPS)
    keep=${keep:-5}
    [[ $keep =~ ^[1-9][0-9]*$ ]] || die "STACK_KEEP_DUMPS must be a whole number above 0"
    # Compose interpolates db/lan.yml's ${STACK_DB_HBA_FILE:?}
    if lan_db; then export STACK_DB_HBA_FILE="$HBA_FILE"; fi
    mkdir -p "$env_dir/backups"
    out="$env_dir/backups/$(date -u +%Y%m%dT%H%M%SZ).dump"
    # pg_dump writes to a .partial that becomes the .dump only once it
    # succeeds, so an error, Ctrl-C or dropped SSH session never leaves a
    # truncated file that looks like a backup. The signal traps turn a
    # signal into an exit so the EXIT trap (cleanup) removes the partial.
    partial="$out.partial"
    CLEANUP+=("$partial")
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    if ! dump_db > "$partial"; then
      die "pg_dump failed"
    fi
    mv "$partial" "$out"
    # names are UTC timestamps, so name order is age order (newest first).
    # Only *.dump counts: a stray .partial (maybe a dump still running) is
    # never counted and never deleted here.
    printf '%s\n' "$env_dir/backups"/*.dump | sort -r | tail -n +"$((keep + 1))" | while IFS= read -r old; do
      rm -f "$old"
    done
    echo "$out"
    ;;
  pgdump)
    [[ $# -eq 1 ]] || usage
    # Compose interpolates db/lan.yml's ${STACK_DB_HBA_FILE:?}
    if lan_db; then export STACK_DB_HBA_FILE="$HBA_FILE"; fi
    out=$1
    partial="$out.partial"
    # as in dump: a signal becomes an exit, so the EXIT trap (cleanup) removes the partial
    CLEANUP+=("$partial")
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    dump_db --no-owner --no-acl > "$partial" || die "pg_dump failed"
    mv "$partial" "$out"
    ;;
  revision)
    [[ $# -eq 0 ]] || usage
    # Compose interpolates db/lan.yml's ${STACK_DB_HBA_FILE:?}
    if lan_db; then export STACK_DB_HBA_FILE="$HBA_FILE"; fi
    if external; then
      pg psql -tAc 'SELECT version_num FROM alembic_version' </dev/null
    else
      pg_local psql -tAc 'SELECT version_num FROM alembic_version'
    fi
    ;;
  admin)
    # The first admin (Sirdar's step 11): stdin carries a typed password, never
    # argv; the command's exit code is ss-stack's.
    [[ $# -ge 1 ]] || usage
    dc api exec -T api serversherpa bootstrap-admin "$@"
    ;;
  seed)
    # Starter content (Sirdar's step 20; Slipway's commands.seed): label fonts
    # and templates and the wiki Learning space, which is seeded when the
    # learning site runs (STACK_APPS lists learn, or every app runs) or with
    # --learning. Each command is idempotent; the first that fails stops here
    # with its exit code.
    learning=0
    if [[ ${1:-} == --learning ]]; then learning=1; shift; fi
    [[ $# -eq 0 ]] || usage
    if app_on learn; then learning=1; fi
    dc api exec -T api serversherpa seed-label-fonts
    dc api exec -T api serversherpa seed-label-templates
    if (( learning )); then dc api exec -T api serversherpa learning-seed; fi
    ;;
  has-data)
    # Whether this environment already has data (Slipway's commands.has_data,
    # asked before a backup, a reset or seeding a new instance):
    #   0  this host's database has ServerSherpa's tables
    #   3  no data yet: no database volume, or a database with no tables
    #   4  the database isn't this host's alone: a managed or LAN data VM
    #      database (STACK_EXTERNAL_DATA, STACK_DB_HOST), or this host is a
    #      data VM that app servers elsewhere write to (STACK_DB_PUBLISH).
    #      Slipway still backs it up but won't restore over or reset it.
    # Docker or Postgres not answering is an error (exit 1), never "no data".
    [[ $# -eq 0 ]] || usage
    if external || [[ -n $(env_value STACK_DB_HOST) ]]; then
      echo "The database is outside this host (STACK_EXTERNAL_DATA or STACK_DB_HOST is set)."
      exit 4
    fi
    if lan_db; then
      echo "This host is a data VM: app servers on other hosts use its database (STACK_DB_PUBLISH=1)."
      exit 4
    fi
    volume="ss-$STACK_ENV-db_pgdata"
    volumes=$(docker volume ls -q </dev/null) || die "couldn't list Docker's volumes (is Docker running?)"
    if ! grep -Fxq -- "$volume" <<<"$volumes"; then
      echo "No data yet: there is no volume $volume."
      exit 3
    fi
    # The volume is there: start its database (never anything else) and ask it.
    ensure_network
    dc db up -d "${WAIT[@]}" </dev/null
    tables=$(pg_local psql -v ON_ERROR_STOP=1 -tAc \
      "SELECT to_regclass('public.alembic_version') IS NOT NULL" </dev/null) \
      || die "couldn't ask the database in $volume whether it has tables"
    if [[ $(trim "$tables") == t ]]; then
      echo "The database in $volume has ServerSherpa's tables."
      exit 0
    fi
    echo "No data yet: the database in $volume has no tables."
    exit 3
    ;;
  accepts)
    # Whether this commit can run a database at the revision in <file> (one
    # line, as ss-stack revision prints it; Slipway's commands.accepts):
    # 0 when this commit has that migration (up then migrates the data
    # forward), 3 when it doesn't, with the reason on the last line. This is
    # a membership test, not "<= the newest": a dump from another branch has
    # a number this commit may have no migration for. Needs no database.
    [[ $# -eq 1 ]] || usage
    [[ -f $1 && -r $1 ]] || die "no such revision file: $1"
    versions="$STACK_DIR/../../api/migrations/versions"
    [[ -d $versions ]] || die "this checkout has no api/migrations/versions"
    rev=$(trim "$(head -c 200 -- "$1")")
    if [[ ! $rev =~ ^[0-9]{1,8}$ ]]; then
      shown=$(printf '%s' "$rev" | LC_ALL=C tr -c 'A-Za-z0-9._-' '?' | cut -c 1-40)
      echo "'$shown' isn't a ServerSherpa migration number"
      exit 3
    fi
    if compgen -G "$versions/${rev}_*.py" >/dev/null; then
      echo "This commit has migration $rev."
      exit 0
    fi
    echo "This commit has no migration $rev: the data is newer than this commit, or from another branch; deploy a commit that has it"
    exit 3
    ;;
  verify-dump)
    # Whether <file> is a complete pg_dump custom-format archive (Slipway's
    # commands.verify_dump). pg_restore reads every entry and writes the
    # script to /dev/null, in a container with no network: a cut-off file
    # fails here (pg_restore --list reads only the table of contents at the
    # start, so it passes one). Nothing is changed.
    [[ $# -eq 1 ]] || usage
    [[ -f $1 && -r $1 ]] || die "no such dump file: $1"
    docker run --rm -i --network none "$PG_IMAGE" pg_restore -f /dev/null < "$1" \
      || die "$1 isn't a complete pg_dump archive"
    echo "$1 is a complete pg_dump archive."
    ;;
  clear-sessions)
    # Sign everyone out (Slipway's commands.after_import, after another
    # environment's data was restored here): the copy's sessions and
    # remembered browsers belong to its source. restore --clear-sessions
    # does the same as part of a restore.
    [[ $# -eq 0 ]] || usage
    # Compose interpolates db/lan.yml's ${STACK_DB_HBA_FILE:?}
    if lan_db; then export STACK_DB_HBA_FILE="$HBA_FILE"; fi
    psql_run "$CLEAR_SESSIONS" || die "couldn't clear the sessions"
    echo "Signed everyone out: the sessions and remembered browsers of the copy are gone."
    ;;
  export-objects)
    # Every object of the environment's bucket into one tar at <out.tar>
    # (Slipway's commands.export_files; format serversherpa-objects-v1, see
    # objects.py). objects.py writes <out.tar>.partial and renames it once
    # complete; as in pgdump, a signal becomes an exit, so the EXIT trap
    # removes a partial left behind.
    [[ $# -eq 1 ]] || usage
    [[ ! -e $1 && ! -L $1 ]] || die "$1 already exists"
    CLEANUP+=("$1.partial")
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # objects.py says why on stderr when it fails; its exit code is ss-stack's
    objects_run export "$1"
    ;;
  import-objects)
    # Put every object of <in.tar> into the environment's bucket (Slipway's
    # commands.import_files). An object with the same key is replaced; the
    # bucket's other objects are kept.
    [[ $# -eq 1 ]] || usage
    [[ -f $1 && -r $1 ]] || die "no such objects file: $1"
    objects_run import "$1"
    ;;
  *)
    usage
    ;;
esac
