# Kiosk (web mode) container config — copy to kiosk/.env (git-ignored).
# URLs as the BROWSER sees them. In production the kiosk origin must be in
# the API's SS_ALLOWED_ORIGINS and SS_COOKIE_DOMAIN must be the shared
# parent domain, or the refresh cookie never reaches the kiosk.
KIOSK_API_URL=http://localhost:8000
KIOSK_PORTAL_URL=http://localhost:5173
KIOSK_PORT=8090
KIOSK_VERSION=0.1.0
