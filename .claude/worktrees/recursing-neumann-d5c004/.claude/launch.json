{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "portal", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "api/.venv/bin/uvicorn",
      "runtimeArgs": ["--factory", "serversherpa.api.app:create_app", "--app-dir", "api/src", "--port", "8000"],
      "port": 8000
    }
  ]
}
