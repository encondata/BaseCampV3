config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.8.1'
	option netmask '255.255.255.0'

config interface 'wan'
	option device 'eth0'
	option proto 'dhcp'

config interface 'tethering'
	option proto 'dhcp'
	option device 'usb0'

config interface 'modem_1_1_2'
	option proto 'qmi'
	option device '/dev/cdc-wdm0'
