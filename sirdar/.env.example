# ── Sirdar ──────────────────────────────────────────────────────────
SIRDAR_ENV=production
# Password for Sirdar's own Postgres (docker-compose builds the URL from it).
# Must be a long random value; generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SIRDAR_DB_PASSWORD=
# Host port the app listens on (behind your reverse proxy).
SIRDAR_PORT=8098
# Host address the port is published on.
#   127.0.0.1  this machine only (the reverse proxy runs on the same box)
#   0.0.0.0    all interfaces: reachable at http://<host-ip>:<port> on the LAN;
#              required when the proxy runs on another machine or in a container
#              on a different network
#   or a specific host IP
SIRDAR_BIND=127.0.0.1
# Long random string: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SIRDAR_JWT_SECRET=
# The portal's Postgres, used ONLY by "Import from portal" (read only).
# Prefer a role that can only SELECT people, user_accounts, roles,
# person_roles, access_groups, access_group_members, totp_backup_codes,
# system_config. Leave empty to disable the import.
SIRDAR_SOURCE_DATABASE_URL=
# Cookie domain for the refresh cookie; empty = this host only.
SIRDAR_COOKIE_DOMAIN=
# Browser origin(s) allowed to call the API from another site, comma-separated,
# e.g. https://sirdar.example.com. Only needed when a different site calls the
# API: the web app and API are served from the same origin, so blank is normal.
# Each entry is http(s)://host[:port], no path.
SIRDAR_ALLOWED_ORIGINS=

# ── Must equal the portal's values ─────────────────────────────────
# Copied password hashes and 2FA seeds only verify with these.
SS_PASSWORD_PEPPER=
SS_TOTP_ENCRYPTION_KEY=

# Minimum length for local (CLI-created) passwords; same default as the portal.
SIRDAR_PASSWORD_MIN_LENGTH=8

# ── Target deployment (optional: the Deploy page) ──────────────────
# Read-only cloud views and an SSH connection test. Leave blank to disable.
# DigitalOcean: read-only personal access token (control panel > API > Tokens).
SIRDAR_DEPLOY_DO_TOKEN=
# Optional default region; the Deploy page lists DigitalOcean's available regions.
SIRDAR_DEPLOY_DO_REGION=
# AWS: access key id and secret of a read-only IAM user.
SIRDAR_DEPLOY_AWS_ACCESS_KEY_ID=
SIRDAR_DEPLOY_AWS_SECRET_ACCESS_KEY=
# AWS region, e.g. us-east-1.
SIRDAR_DEPLOY_AWS_REGION=
# Google Cloud project id.
SIRDAR_DEPLOY_GCP_PROJECT_ID=
# Service-account JSON file name inside deploy-keys/ (bare name, no slashes).
SIRDAR_DEPLOY_GCP_CREDENTIALS_FILE=
# Google Cloud region, e.g. us-central1.
SIRDAR_DEPLOY_GCP_REGION=
# Custom SSH target for the connection test: host, port, user.
SIRDAR_DEPLOY_SSH_HOST=
SIRDAR_DEPLOY_SSH_PORT=22
SIRDAR_DEPLOY_SSH_USER=
# SSH password (blank when you use a key).
SIRDAR_DEPLOY_SSH_PASSWORD=
# SSH private key: file name inside deploy-keys/ (bare name, no slashes).
# Keep it chmod 600 and readable by uid 10001 (the container user).
SIRDAR_DEPLOY_SSH_KEY_PATH=
# Passphrase for that key, if it has one.
SIRDAR_DEPLOY_SSH_KEY_PASSPHRASE=
# Host folder mounted read-only at /app/deploy-keys (relative to the compose
# file). Optional; only change it to keep keys elsewhere.
# SIRDAR_DEPLOY_KEYS_DIR=./deploy-keys
