# ============================================================
# ServerSherpa — environment configuration template
# ============================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate the TOTP Fernet key with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Production values live only in /srv/serversherpa/.env on the droplet
# (chmod 600). Development uses the local Docker stack in
# docker-compose.dev.yml — see the dev-value hints in comments.
# ============================================================

# ── Runtime ────────────────────────────────────────────────
SS_ENV=production                 # production | staging | development
SS_LOG_LEVEL=INFO                 # DEBUG in development
SS_API_BASE_URL=https://api.example.com   # dev: http://localhost:8000

# ── Database ───────────────────────────────────────────────
# Production: DO Managed Postgres over the private VPC hostname, TLS required.
# Development: local Docker Postgres (docker-compose.dev.yml), TLS disabled.
SS_DATABASE_URL=postgresql+asyncpg://serversherpa_app:CHANGEME@private-db-host:25060/serversherpa
SS_DATABASE_SSL=require           # require (prod/staging) | disable (dev only)
SS_DATABASE_POOL_SIZE=10
SS_DATABASE_POOL_MAX_OVERFLOW=20

# ── Auth / crypto ──────────────────────────────────────────
SS_JWT_SECRET=CHANGEME                  # signs access tokens (HS256)
SS_ACCESS_TOKEN_TTL_SECONDS=900         # 15 min; internal plumbing, invisible to users
SS_SESSION_TTL_SECONDS=86400            # how long a login lasts, ABSOLUTE from login.
                                        # Refresh tokens rotate within this window but
                                        # always inherit the original login's deadline.
SS_TOTP_ENCRYPTION_KEY=CHANGEME         # Fernet key; encrypts TOTP seeds at rest
SS_PASSWORD_PEPPER=CHANGEME             # server-side pepper applied before Argon2

# ── CORS / cookies ─────────────────────────────────────────
SS_ALLOWED_ORIGINS=https://portal.example.com,https://kiosk.example.com
SS_COOKIE_DOMAIN=.example.com           # dev: leave empty for localhost
# Portal origin the log-service health-probes for the Processes page
SS_PORTAL_ORIGIN=http://localhost:5173

# ── Object storage (DO Spaces in prod, MinIO in dev) ───────
SS_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com   # dev: http://localhost:9000
SS_SPACES_REGION=nyc3                   # dev: us-east-1 (MinIO default)
SS_SPACES_BUCKET=serversherpa-prod          # dev: serversherpa-dev
SS_SPACES_ACCESS_KEY=CHANGEME
SS_SPACES_SECRET_KEY=CHANGEME
SS_SPACES_PRESIGN_TTL_SECONDS=600
SS_SPACES_USE_PATH_STYLE=false          # dev: true (MinIO needs path-style URLs)

# ── Email ──────────────────────────────────────────────────
# Development: Mailpit (docker-compose.dev.yml) catches all mail,
# UI at http://localhost:8025 — no real messages are sent.
SS_SMTP_HOST=smtp.example.com           # dev: localhost
SS_SMTP_PORT=587                        # dev: 1026 (Mailpit; 1025 is taken by macOS)
SS_SMTP_USERNAME=CHANGEME               # dev: leave empty
SS_SMTP_PASSWORD=CHANGEME               # dev: leave empty
SS_SMTP_STARTTLS=true                   # dev: false
SS_SMTP_FROM=noreply@example.com

# ── AI assistant ────────────────────────────────────────────
# Local Ollama (OpenAI-compatible). Point SS_AI_BASE_URL at the Mac mini
# in prod (e.g. http://mini16.local:11434/v1). Disabled by default.
SS_AI_ENABLED=false
SS_AI_BASE_URL=http://localhost:11434/v1
SS_AI_MODEL=qwen3:8b-portal
SS_AI_REASONING_EFFORT=none
SS_AI_TIMEOUT_SECONDS=60

# ── Observability (optional) ───────────────────────────────
SS_SENTRY_DSN=

# God mode — comma-separated words typed into the ⌘K palette to reveal the
# developer nav. NEVER move these to a VITE_* var (Vite inlines them into the
# bundle). Empty disables the feature entirely.
SS_GOD_MODE_WORDS=
SS_GOD_MODE_NAV_COLOR=#00c853
SS_PASSWORD_MIN_LENGTH=8

# DB testing mode (Dev -> Database -> Testing) — password required above
# god mode + the devtools permission before a snapshot/revert session can
# start or end. No default: leave it blank and the Testing tab stays
# disabled (start/end answer 503 db_testing_password_not_configured) until
# you set one.
SS_DB_TESTING_PASSWORD=

# ── Login lockout ──────────────────────────────────────────
SS_MAX_FAILED_LOGINS=10           # failures before temporary lockout
SS_LOCKOUT_SECONDS=900            # lockout duration (15 min)
SS_TOTP_TRUST_DAYS=7              # "Remember this browser" skips the 2FA code for this many days

# ── Scans ──────────────────────────────────────────────────
# Default number of scan-history entries returned when a caller
# doesn't specify a limit (asset/move detail pages). The inline
# roster tab always requests 15. More scan settings will land here.
SS_SCANS_HISTORY_DEFAULT=100

# ── Labels ───────────────────────────────────────────────
SS_LABELARY_BASE_URL=https://api.labelary.com

# ── Reports ──────────────────────────────────────────────
# Rack elevations in PDF reports are rendered by the PORTAL's own SVG
# component, run under Node. Build it with `npm --prefix portal run
# build:rack-renderer` — without it every rack section fails with
# "rack renderer unavailable".
# Path to that built script. Empty = <repo>/portal/dist-node/render-rack.js,
# resolved relative to the API package — which only works from a source
# checkout, so this MUST be set to an absolute path whenever the API is
# installed non-editably (wheel/container/system site-packages).
SS_REPORT_RACK_RENDERER=
# Node binary the report worker spawns (Node >= 20 on the worker host).
SS_REPORT_NODE_BIN=node
# The worker host also needs WeasyPrint's native stack — Pango, Cairo and
# GDK-PixBuf (macOS: `brew install pango`; Debian: libpango-1.0-0
# libpangoft2-1.0-0 libharfbuzz0b libgdk-pixbuf-2.0-0).

# ── Docker compose (dev stack only) ────────────────────────
# Read by docker-compose.dev.yml, ignored by the API itself.
POSTGRES_USER=serversherpa
POSTGRES_PASSWORD=CHANGEME-dev-only
POSTGRES_DB=serversherpa
MINIO_ROOT_USER=serversherpa
MINIO_ROOT_PASSWORD=CHANGEME-dev-only
# Grafana (dev log UI at http://localhost:3000; Loki datasource provisioned)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
