# Settings for docker-compose.yml. Copy to .env and edit.

# The address people type to open the page: the Docker host's name or
# address with the port below, or the reverse proxy's https name. The page
# refuses every other name.
#   http://10.0.0.5:8795
#   https://loadtest.example.com
LOADTEST_PUBLIC_URL=

# The page's sign-in. These are the defaults; change them on any network
# you do not fully trust.
LOADTEST_USERNAME=admin
LOADTEST_PASSWORD=password123

# The port on the Docker host. Keep LOADTEST_PUBLIC_URL in step with it
# (a reverse proxy's name needs no port).
LOADTEST_PORT=8795

# The Docker host address the port listens on. 127.0.0.1 when a reverse
# proxy on the same host is the only way in.
LOADTEST_BIND_IP=0.0.0.0

# The routing service for the truck's road route. Empty uses the public
# OSRM service, which is sent the two sites' coordinates.
LOADTEST_ROUTER_URL=
